PORT=4000
NODE_ENV=development
PGHOST=localhost
PGUSER=postgres
PGPORT=5432
PGDATABASE=gis_lake
PGSSLMODE=disable
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d
# Prefer FCM HTTP v1
FCM_USE_V1=true
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Legacy fallback (optional)
FCM_SERVER_KEY=
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=report-photos
AZURE_BLOB_READ_SAS_MINUTES=60
